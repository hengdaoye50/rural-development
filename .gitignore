# secrets & env
.env
.env.*
!.env.example

# python
__pycache__/
*.pyc
.venv/
venv/
# OCR 专用环境（rapidocr + onnxruntime + pypdfium2），由 uv 创建，不入库
.venv-ocr/

# office temp
~$*
*.tmp
.DS_Store
Thumbs.db

# large exports (regenerable)
data/db/*.sqlite3-journal
reports/_build/

# keep db file itself in git? default: track CSV + scripts; db can be rebuilt
data/db/*.sqlite3

# agent workspace
.mimocode/
.playwright-mcp/

# stage 中间产物（体积大、可重生成）
data/stage/batches/
# candidates 大多是中间产物，但下面三类是**决策台账/名单**，不可再生，必须入库
data/stage/candidates/*
!data/stage/candidates/area-roster-*.csv
!data/stage/candidates/area-media-roster-*.csv
!data/stage/candidates/gap-checks-*.csv
!data/stage/candidates/pending-decisions-*.csv
!data/stage/candidates/t2-decisions-*.csv
